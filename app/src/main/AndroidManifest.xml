<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
        tools:targetApi="n"：networkSecurityConfig 自 API 24 起才被系统读取，低版本直接忽略它
        （不是错误）。标注后 Lint 不再报 UnusedAttribute。
        tools:ignore="DataExtractionRules"：本应用 android:allowBackup="false"，备份整体关闭，
        因此无需再为 API 31+ 提供 dataExtractionRules 规则文件。
    -->
    <application
        android:name=".JavCinema"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="DataExtractionRules"
        tools:targetApi="n">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${fileProviderAuthority}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            screenOrientation="portrait"：本应用全部界面都是竖屏设计（没有 layout-land /
            values-land 资源），唯一需要横屏的是播放页，由 PlayerScreen 在运行时临时请求
            SENSOR_LANDSCAPE。

            这里显式声明而不是交给系统的 UNSPECIFIED，是因为：系统「自动旋转」关闭时，
            UNSPECIFIED 会让应用跟随系统级 Settings.System.USER_ROTATION。一旦那个值
            被别的应用/旧版本写成横屏，本应用启动就会是横屏且自己恢复不了。
            声明成 portrait 后，无论系统锁定方向是什么，应用永远以竖屏启动。

            因此 Lint 的 LockedOrientationActivity / DiscouragedApi 属于**有意为之**，
            不是疏漏，就地抑制。另：两个 Activity 都不再重复声明 android:label ——
            与 application 上的标签相同，属于 RedundantLabel。
        -->
        <activity
            android:name=".activity.MainActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|uiMode|orientation|screenSize|smallestScreenSize"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar.TransparentStatusBar"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.StartActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|uiMode|orientation|screenSize|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Start"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
